# RCS Backend configuration
# Copy to .env and adjust. All keys are optional (sensible dev defaults).

# Storage backend: memory | sqlite | postgres
RCS_STORAGE=postgres

# Used only when RCS_STORAGE=postgres
RCS_DATABASE_URL=postgresql+asyncpg://rcs:rcs@localhost:5432/rcs

# Used only when RCS_STORAGE=sqlite
RCS_DB_PATH=/tmp/rcs.db

# Topology data (used by topology_shell / topology_grid routers)
RCS_TOPOLOGY_DIR=/app/_shared

# Optional API-key auth for the control endpoints (off by default)
RCS_API_AUTH_ENABLED=false
RCS_API_KEY=

# Control loop frequency (Hz)
RCS_CONTROL_HZ=10
